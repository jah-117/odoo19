<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="notification_tree_view" model="ir.ui.view">
        <field name="name">edu.notification.tree</field>
        <field name="model">edu.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="schedule_date"/>
                <field name="time" widget="float_time"/>
                <field name="sent_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="notification_form_view" model="ir.ui.view">
        <field name="name">edu.notification.form</field>
        <field name="model">edu.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">

                <header>

                    <!-- Send immediately -->
                    <button name="action_send_notification"
                            string="Send Now"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Schedule -->
                    <button name="action_schedule_notification"
                            string="Schedule"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>

                    <!-- Status -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,scheduled,sent"/>

                </header>

                <sheet>

                    <!-- Title -->
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"
                                   placeholder="Notification Name"/>
                        </h1>
                    </div>

                    <group string="Recipients">

                        <group>
                            <field name="to_partner_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>

                            <field name="to_class_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>

                            <field name="to_department_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </group>

                        <group>
                            <field name="to_cc_partner_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </group>

                    </group>


                    <group string="Notification Content">

                        <field name="subject_id"
                               placeholder="Notification subject"/>

                        <field name="body"
                               widget="html"
                               placeholder="Write your notification here..."/>

                    </group>

                    <group string="Footer">
                        <field name="footer_id"
                               options="{'no_create_edit': True}"/>
                    </group>


                    <group string="Scheduling">

                        <group>
                            <field name="schedule_date"
                                   invisible="not is_scheduled"/>
                            <field name="time"
                                   widget="float_time"
                                   invisible="not is_scheduled"/>
                        </group>

                        <group>
                            <field name="sent_date"
                                   readonly="1"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <record id="action_edu_notification_view" model="ir.actions.act_window">
        <field name="name">Notification Scheduler</field>
        <field name="res_model">edu.notification</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="notification_footer_tree_view" model="ir.ui.view">
        <field name="name">edu.notification.footer.tree</field>
        <field name="model">edu.notification.footer</field>
        <field name="arch" type="xml">
            <list string="Notification Footers">
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="notification_footer_form_view" model="ir.ui.view">
        <field name="name">edu.notification.footer.form</field>
        <field name="model">edu.notification.footer</field>
        <field name="arch" type="xml">
            <form string="Notification Footer">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Footer Name"/>
                        </h1>
                    </div>

                    <group>
                        <field name="content"
                               widget="html"
                               placeholder="Write footer content..."/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_edu_notification_footer" model="ir.actions.act_window">
        <field name="name">Notification Footers</field>
        <field name="res_model">edu.notification.footer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="notification_footer_tree_view"/>
    </record>
</odoo>