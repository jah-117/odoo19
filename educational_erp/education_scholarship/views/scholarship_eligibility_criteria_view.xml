<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_education_eligibility_criteria_tree" model="ir.ui.view">
        <field name="name">scholarship.eligibility.criteria.tree</field>
        <field name="model">scholarship.eligibility.criteria</field>
        <field name="arch" type="xml">
            <list string="Eligibility Criteria">
                <field name="criteria_id"/>
                <field name="operator"/>
                <field name="value"/>
                <field name="is_require_document" string="Need Document"/>
            </list>
        </field>
    </record>

    <record id="view_education_eligibility_criteria_form" model="ir.ui.view">
        <field name="name">scholarship.eligibility.criteria.form</field>
        <field name="model">scholarship.eligibility.criteria</field>
        <field name="arch" type="xml">
            <form string="Eligibility Criteria">
                <sheet>
                    <field name="criteria_id" placeholder="Criteria"/>
                    <field name="operator" placeholder="Operator"/>
                    <field name="value" placeholder="value"/>
                    <group>
                    <field name="is_require_document" string="Need Document"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_scholarship_eligibility_criteria" model="ir.actions.act_window">
        <field name="name">Eligibility Criteria</field>
        <field name="res_model">scholarship.eligibility.criteria</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
