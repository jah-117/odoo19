<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_education_scholarship_application" model="ir.actions.act_window">
        <field name="name">Scholarship Applications</field>
        <field name="res_model">education.scholarship.application</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new Scholarship Application
            </p>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_education_scholarship_application_tree" model="ir.ui.view">
        <field name="name">education.scholarship.application.tree</field>
        <field name="model">education.scholarship.application</field>
        <field name="arch" type="xml">
            <list string="Scholarship Applications">
                <field name="name"/>
                <field name="student_id"/>
                <field name="scholarship_id"/>
                <field name="application_date"/>
                <field name="state" widget="badge" decoration-info="state in ('draft', 'submitted')" decoration-warning="state == 'review'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_education_scholarship_application_form" model="ir.ui.view">
        <field name="name">education.scholarship.application.form</field>
        <field name="model">education.scholarship.application</field>
        <field name="arch" type="xml">
            <form string="Scholarship Application">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="Review" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="education_security.group_education_admin"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'review'" groups="education_security.group_education_admin"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted', 'review')" groups="education_security.group_education_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,review,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="academic_year_id"/>
                            <field name="scholarship_id" readonly="state != 'draft'" domain="[('state', '=', 'active'), ('academic_year_id', '=', academic_year_id)]"/>
                        </group>
                        <group>
                            <field name="application_date" readonly="state != 'draft'"/>
                            <field name="family_income" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Submitted Criteria" name="submitted_criteria">
                            <field name="submitted_criteria_ids" readonly="1">
                                <list string="Submitted Criteria">
                                    <field name="eligibility_criteria_id"/>
                                    <field name="student_value"/>
                                    <field name="document_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks">
                            <field name="remarks" placeholder="Enter remarks..."/>
                        </page>
                        <page string="Rejection Details" invisible="state != 'rejected'">
                            <group>
                                <field name="rejection_reason" readonly="state == 'rejected'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Pivot View for Reports -->
    <record id="view_education_scholarship_application_pivot" model="ir.ui.view">
        <field name="name">education.scholarship.application.pivot</field>
        <field name="model">education.scholarship.application</field>
        <field name="arch" type="xml">
            <pivot string="Scholarship Applications Analysis" sample="1">
                <field name="scholarship_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Reports -->
    <record id="view_education_scholarship_application_graph" model="ir.ui.view">
        <field name="name">education.scholarship.application.graph</field>
        <field name="model">education.scholarship.application</field>
        <field name="arch" type="xml">
            <graph string="Scholarship Applications" sample="1">
                <field name="scholarship_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
</odoo>
