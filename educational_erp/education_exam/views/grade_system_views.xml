<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         Grading System Views
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Form View -->
    <record id="view_edu_exam_grade_system_form" model="ir.ui.view">
        <field name="name">edu.exam.grade.system.form</field>
        <field name="model">edu.exam.grade.system</field>
        <field name="arch" type="xml">
            <form string="Grading System">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Grading System Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard 10-Point CGPA Scale"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. 10_POINT_CGPA"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Grade Levels" name="grade_lines">
                            <field name="line_ids">
                                <list string="Grade Levels" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Grade" placeholder="e.g. A+"/>
                                    <field name="min_percentage" string="Min %"/>
                                    <field name="max_percentage" string="Max %"/>
                                    <field name="grade_point" string="Grade Point / GPA"/>
                                    <field name="pass_fail"/>
                                    <field name="description" placeholder="e.g. Outstanding / Distinction"/>
                                </list>
                            </field>
                        </page>
                        <page string="Policy &amp; Remarks" name="policy">
                            <field name="description" placeholder="Institutional guidelines, evaluation notes, or policy details for this grading system..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_edu_exam_grade_system_list" model="ir.ui.view">
        <field name="name">edu.exam.grade.system.list</field>
        <field name="model">edu.exam.grade.system</field>
        <field name="arch" type="xml">
            <list string="Grading Systems">
                <field name="name"/>
                <field name="code"/>
                <field name="is_default" widget="boolean_toggle" string="Default"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_edu_exam_grade_system_search" model="ir.ui.view">
        <field name="name">edu.exam.grade.system.search</field>
        <field name="model">edu.exam.grade.system</field>
        <field name="arch" type="xml">
            <search string="Search Grading Systems">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Default Scales" name="default_scales" domain="[('is_default', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_edu_exam_grade_system" model="ir.actions.act_window">
        <field name="name">Grading Systems</field>
        <field name="res_model">edu.exam.grade.system</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_grade_system_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Examination Grading System
            </p>
            <p>
                Configure letter grades, percentage brackets, GPA/grade points, and passing criteria tailored to your school or college.
            </p>
        </field>
    </record>

</odoo>
