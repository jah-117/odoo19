<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        education_exam — Menu structure
        Hangs under the root Education menu defined in education_config.
    -->

    <!-- ── Examinations top-level submenu ─────────────────────────────── -->
    <menuitem
        id="menu_education_exam_root"
        name="Examinations"
        parent="education_config.menu_education_root"
        sequence="40"
        groups="education_security.group_education_admin,education_security.group_education_teacher"/>

    <!-- Exam Schedule -->
    <menuitem
        id="menu_edu_exam"
        name="Exam Schedule"
        parent="menu_education_exam_root"
        action="action_edu_exam"
        sequence="10"
        groups="education_security.group_education_admin,education_security.group_education_teacher"/>

    <!-- Results -->
    <menuitem
        id="menu_edu_exam_result"
        name="Results"
        parent="menu_education_exam_root"
        action="action_edu_exam_result"
        sequence="20"
        groups="education_security.group_education_admin,education_security.group_education_teacher"/>

    <!-- Revaluation Requests (Replaces Enter Marks) -->
    <menuitem
        id="menu_edu_exam_reevaluation"
        name="Revaluation Requests"
        parent="menu_education_exam_root"
        action="action_edu_exam_reevaluation"
        sequence="30"
        groups="education_security.group_education_admin,education_security.group_education_teacher"/>

    <!-- ── Configuration ─────────────────────────────────────────────── -->
    <menuitem
        id="menu_edu_exam_config"
        name="Configuration"
        parent="menu_education_exam_root"
        sequence="90"
        groups="education_security.group_education_admin"/>

    <!-- Grading Systems -->
    <menuitem
        id="menu_edu_exam_grade_system"
        name="Grading Systems"
        parent="menu_edu_exam_config"
        action="action_edu_exam_grade_system"
        sequence="10"
        groups="education_security.group_education_admin"/>

</odoo>

