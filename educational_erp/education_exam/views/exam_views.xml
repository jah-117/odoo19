<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam.result — Search view
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_result_search" model="ir.ui.view">
        <field name="name">edu.exam.result.search</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <search string="Search Results">
                <field name="student_name"/>
                <field name="subject_id"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <separator/>
                <filter string="Pass" name="pass" domain="[('pass_fail','=','pass')]"/>
                <filter string="Fail" name="fail" domain="[('pass_fail','=','fail')]"/>
                <filter string="Absent" name="absent" domain="[('pass_fail','=','absent')]"/>
                <separator/>
                <filter string="Published" name="published"
                        domain="[('state','=','published')]"/>
                <group>
                    <filter string="Exam" name="group_exam"
                            context="{'group_by': 'exam_id'}"/>
                    <filter string="Class" name="group_class"
                            context="{'group_by': 'class_id'}"/>
                    <filter string="Subject" name="group_subject"
                            context="{'group_by': 'subject_id'}"/>
                    <filter string="Grade" name="group_grade"
                            context="{'group_by': 'grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_exam_result" model="ir.actions.act_window">
        <field name="name">Exam Results</field>
        <field name="res_model">edu.exam.result</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_result_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No results yet</p>
            <p>Use the Mark Entry wizard to bulk-enter student marks.</p>
        </field>
    </record>

    <!-- ── edu.exam Form View ─────────────────────────────────────────── -->
    <record id="view_edu_exam_form" model="ir.ui.view">
        <field name="name">edu.exam.form</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <form string="Examination">
                <header>
                    <button name="action_schedule"
                            type="object"
                            string="Schedule"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_start" type="object"
                            string="Exam Ongoing" class="btn-warning"
                            invisible="state != 'scheduled'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_start_valuation" type="object"
                            string="Start Valuation" class="btn-primary"
                            invisible="state != 'ongoing'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_enter_marks" type="object"
                            string="Enter Marks" class="btn-primary"
                            invisible="state != 'valuation'"/>
                    <button name="action_publish_results" type="object"
                            string="Publish Results" class="btn-success"
                            invisible="state != 'valuation' or result_count == 0"
                            groups="education_security.group_education_admin"/>
                    <button name="action_close" type="object"
                            string="Close" class="btn-secondary"
                            invisible="state != 'result_published'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'scheduled'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_print_results" type="object"
                            string="Print Results" class="btn-secondary"
                            invisible="result_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,ongoing,valuation,result_published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-book"
                                name="%(action_edu_exam_result)d" type="action"
                                invisible="result_count == 0"
                                context="{'default_exam_id': id,
                                          'search_default_exam_id': id}">
                            <field name="result_count" widget="statinfo"
                                   string="Results"/>
                        </button>
                        <button name="action_view_seats"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="seating_count == 0">
                            <field name="seating_count" widget="statinfo"
                                   string="Seats"/>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count"
                                   widget="statinfo"
                                   string="Invoices"/>
                        </button>

                        <button name="action_view_enrollments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-graduation-cap"
                                invisible="enrollment_count == 0">
                            <field name="enrollment_count"
                                   widget="statinfo"
                                   string="Enrollments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="code" class="text-muted small"/>
                        <h1>
                            <field name="code" readonly="1" class="text-muted me-2"/>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="exam_type"/>
                            <field name="academic_year_id"/>
                            <field name="class_ids" widget="many2many_tags"/>
                            <field name="grade_system_id"/>
                            <field name="is_paid_exam" readonly="state != 'draft'"/>
                            <field name="exam_fee" invisible="not is_paid_exam"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="published_at" invisible="not published_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: Subject Schedule -->
                        <page string="Subject Schedule" name="subjects">
                            <field name="subject_line_ids">
                                <list string="Subjects" editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="exam_date" required="1"/>
                                    <field name="exam_time" widget="float_time" required="1"/>
                                    <field name="duration_hours"/>
                                    <field name="max_marks"/>
                                    <field name="pass_marks"/>
                                    <field name="classroom_id" required="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 2: Seating Plan -->
                        <page string="Seating Plan" name="seating">
                            <field name="seating_ids">
                                <list string="Seating" editable="bottom">
                                    <field name="enrollment_id"/>
                                    <field name="student_name" readonly="1"/>
                                    <field name="class_id" readonly="1"/>
                                    <field name="classroom_id"/>
                                    <field name="seat_no"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 3: Invigilators -->
                        <page string="Invigilators" name="invigilators">
                            <field name="invigilator_ids">
                                <list string="Invigilators" editable="bottom">
                                    <field name="date"/>
                                    <field name="faculty_id"/>
                                    <field name="classroom_id"/>
                                    <field name="subject"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 4: Results -->
                        <page string="Results" name="results"
                              invisible="state == 'draft'">
                            <field name="result_ids">
                                <list string="Results"
                                      decoration-success="pass_fail == 'pass'"
                                      decoration-danger="pass_fail == 'fail'"
                                      decoration-muted="pass_fail == 'absent'">
                                    <field name="student_name"/>
                                    <field name="class_id"/>
                                    <field name="subject_id"/>
                                    <field name="marks_obtained"/>
                                    <field name="max_marks"/>
                                    <field name="percentage" string="Percentage (%)"/>
                                    <field name="grade"/>
                                    <field name="pass_fail" widget="badge"
                                           decoration-success="pass_fail == 'pass'"
                                           decoration-danger="pass_fail == 'fail'"
                                           decoration-warning="pass_fail == 'absent'"/>
                                    <field name="rank"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'published'"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 5: Notes -->
                        <page string="Instructions" name="notes">
                            <field name="notes" placeholder="Exam rules, instructions…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── edu.exam List View ─────────────────────────────────────────── -->
    <record id="view_edu_exam_list" model="ir.ui.view">
        <field name="name">edu.exam.list</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <list string="Examinations" default_order="date_from desc">
                <field name="code" optional="hide"/>
                <field name="name"/>
                <field name="exam_type" widget="badge"
                       decoration-info="exam_type == 'unit_test'"
                       decoration-warning="exam_type == 'mid_term'"
                       decoration-danger="exam_type == 'final'"/>
                <field name="academic_year_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="subject_count" string="Subjects"/>
                <field name="result_count" string="Results"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('scheduled', 'valuation')"
                       decoration-warning="state == 'ongoing'"
                       decoration-success="state == 'result_published'"
                       decoration-primary="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ── edu.exam Search View ──────────────────────────────────────── -->
    <record id="view_edu_exam_search" model="ir.ui.view">
        <field name="name">edu.exam.search</field>
        <field name="model">edu.exam</field>
        <field name="arch" type="xml">
            <search string="Search Exams">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="class_ids"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Scheduled" name="scheduled" domain="[('state','=','scheduled')]"/>
                <filter string="Ongoing" name="ongoing" domain="[('state','=','ongoing')]"/>
                <filter string="Valuation" name="valuation" domain="[('state','=','valuation')]"/>
                <filter string="Results Published" name="published"
                        domain="[('state','=','result_published')]"/>
                <separator/>
                <filter string="Final Exams" name="final"
                        domain="[('exam_type','=','final')]"/>
                <filter string="Mid-Terms" name="midterm"
                        domain="[('exam_type','=','mid_term')]"/>
                <group>
                    <filter string="Exam Type" name="group_type"
                            context="{'group_by': 'exam_type'}"/>
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── edu.exam Window Action ────────────────────────────────────── -->
    <record id="action_edu_exam" model="ir.actions.act_window">
        <field name="name">Examinations</field>
        <field name="res_model">edu.exam</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No exams scheduled yet</p>
            <p>Create an exam, add subject schedule and assign seating.</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam.result — Standalone views
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="edu_exam_reevaluation_wizard_action" model="ir.actions.act_window">
        <field name="name">Request Re-evaluation</field>
        <field name="res_model">edu.exam.reevaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_edu_exam_result_form" model="ir.ui.view">
        <field name="name">edu.exam.result.form</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <form string="Exam Result" duplicate="0">
                <header>
                    <button name="%(edu_exam_reevaluation_wizard_action)d"
                            type="action" string="Request Re-evaluation"
                            invisible="state != 'published'"
                            context="{'default_result_id': id}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <field name="has_approved_reevaluation" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-refresh"
                                name="action_view_reevaluations" type="object"
                                invisible="reevaluation_count == 0">
                            <field name="reevaluation_count" widget="statinfo" string="Revaluations"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="exam_id" readonly="state == 'published'"/>
                            <field name="enrollment_id" readonly="state == 'published'"/>
                            <field name="student_name" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="subject_id" readonly="state == 'published'"/>
                            <field name="marks_obtained"
                                   readonly="state == 'published' and not has_approved_reevaluation"/>
                            <field name="max_marks" readonly="state == 'published'"/>
                            <field name="pass_marks" readonly="state == 'published'"/>
                            <field name="absent" readonly="state == 'published'"/>
                            <field name="published_at" invisible="not published_at"/>
                        </group>
                    </group>
                    <group string="Computed Results" readonly="1">
                        <group>
                            <field name="percentage"/>
                            <field name="grade"/>
                            <field name="grade_point"/>
                        </group>
                        <group>
                            <field name="pass_fail" widget="badge"
                                   decoration-success="pass_fail == 'pass'"
                                   decoration-danger="pass_fail == 'fail'"/>
                            <field name="rank"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Revaluation Requests" name="reevaluations">
                            <field name="reevaluation_ids" readonly="1">
                                <list string="Revaluation Requests">
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="reason"/>
                                    <field name="reviewed_by_id"/>
                                    <field name="review_date"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'pending'"
                                           decoration-info="state == 'approved'"
                                           decoration-success="state == 'revaluated'"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Change History" name="history">
                            <field name="history_ids">
                                <list string="History" create="false" delete="false">
                                    <field name="change_date"/>
                                    <field name="old_marks"/>
                                    <field name="new_marks"/>
                                    <field name="delta"/>
                                    <field name="changed_by_id"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_edu_exam_result_list" model="ir.ui.view">
        <field name="name">edu.exam.result.list</field>
        <field name="model">edu.exam.result</field>
        <field name="arch" type="xml">
            <list string="Exam Results" duplicate="0"
                  decoration-success="pass_fail == 'pass'"
                  decoration-danger="pass_fail == 'fail'"
                  decoration-muted="pass_fail == 'absent'">
                <field name="exam_id" optional="hide"/>
                <field name="student_name"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="marks_obtained"/>
                <field name="max_marks"/>
                <field name="percentage" string="Percentage (%)"/>
                <field name="grade"/>
                <field name="grade_point" optional="show"/>
                <field name="pass_fail" widget="badge"
                       decoration-success="pass_fail == 'pass'"
                       decoration-danger="pass_fail == 'fail'"
                       decoration-warning="pass_fail == 'absent'"/>
                <field name="rank"/>
                <field name="published_at" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_exam_seating_list" model="ir.ui.view">
        <field name="name">edu.exam.seating.list</field>
        <field name="model">edu.exam.seating</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_name"/>
                <field name="enrollment_id"/>
                <field name="class_id"/>
                <field name="classroom_id"/>
                <field name="seat_no"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Mark Entry Wizard
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_mark_entry_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.mark.entry.wizard.form</field>
        <field name="model">edu.exam.mark.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark Entry">
                <sheet>
                    <group string="Select Exam &amp; Class">
                        <group>
                            <field name="exam_id"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list string="Student Marks" editable="bottom">
                            <field name="enrollment_id" column_invisible="1" force_save="1"/>
                            <field name="student_name" readonly="1"/>
                            <field name="subject_id" readonly="1" force_save="1"/>
                            <field name="max_marks" readonly="1" optional="show"/>
                            <field name="pass_marks" readonly="1" optional="show"/>
                            <field name="absent"/>
                            <field name="marks_obtained"
                                   readonly="absent"
                                   decoration-danger="marks_obtained == 0 and not absent"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_marks" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mark_entry_wizard" model="ir.actions.act_window">
        <field name="name">Enter Marks</field>
        <field name="res_model">edu.exam.mark.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Re-evaluation Wizard
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_reevaluation_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.wizard.form</field>
        <field name="model">edu.exam.reevaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Re-evaluation">
                <sheet>
                    <group>
                        <field name="result_id" readonly="1"/>
                        <field name="student_name" readonly="1"/>
                        <field name="subject_id" readonly="1"/>
                        <field name="current_marks" readonly="1"/>
                    </group>
                    <group string="Request Details">
                        <field name="reason" nolabel="1"
                               placeholder="Explain why re-evaluation is needed…"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit" type="object"
                            string="Submit Request" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_result_revaluate_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.result.revaluate.wizard.form</field>
        <field name="model">edu.exam.result.revaluate.wizard</field>
        <field name="arch" type="xml">
            <form string="Revaluate Marks">
                <sheet>
                    <field name="result_id" invisible="1"/>

                    <!-- Subject Highlight Banner -->
                    <div class="alert alert-primary d-flex align-items-center justify-content-between mb-3 py-2 px-3"
                         role="status">
                        <div>
                            <span class="text-uppercase small fw-bold text-muted d-block">Subject under Revaluation
                            </span>
                            <h4 class="mb-0 text-primary fw-bold">
                                <field name="subject_id" options="{'no_open': True}" readonly="1"/>
                            </h4>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark fs-6 border">
                                Max:
                                <field name="max_marks" readonly="1"/>
                                | Pass:
                                <field name="pass_marks" readonly="1"/>
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Candidate Details">
                            <field name="student_name" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="exam_id" readonly="1"/>
                        </group>
                        <group string="Current Assessment">
                            <field name="current_marks" readonly="1" string="Original Marks"/>
                            <field name="current_grade" readonly="1"/>
                        </group>
                    </group>

                    <group string="Student Request Reason" invisible="not student_reason">
                        <field name="student_reason" nolabel="1" readonly="1"/>
                    </group>

                    <group string="Revised Evaluation">
                        <group>
                            <field name="new_marks" readonly="absent"/>
                            <field name="absent"/>
                        </group>
                        <group>
                            <field name="publish_result" groups="education_security.group_education_admin"/>
                        </group>
                    </group>

                    <group string="Evaluator Remarks / Audit Reason">
                        <field name="change_reason" nolabel="1"
                               placeholder="Provide reason for score update (e.g. Question 3 recalculation verified)..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_revaluation" type="object"
                            string="Save &amp; Update Marks" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam.reevaluation.reject.wizard — View
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_reevaluation_reject_wizard_form" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.reject.wizard.form</field>
        <field name="model">edu.exam.reevaluation.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Revaluation Request">
                <sheet>
                    <field name="request_id" invisible="1"/>
                    <div class="alert alert-danger d-flex align-items-center mb-3 py-2 px-3" role="status">
                        <i class="fa fa-times-circle fs-4 me-2"/>
                        <div>
                            <strong>Rejecting Revaluation Request</strong>
                            <div class="small">The reason provided below will be displayed to the student on the
                                portal.
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Student &amp; Subject">
                            <field name="student_name" readonly="1"/>
                            <field name="subject_id" readonly="1"/>
                            <field name="exam_id" readonly="1"/>
                        </group>
                        <group string="Student's Request Reason" invisible="not student_reason">
                            <field name="student_reason" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                    <group string="Reason for Rejection">
                        <field name="rejection_reason" nolabel="1"
                               placeholder="Specify the reason for rejecting this revaluation request (e.g. Marks verified and found accurate as per grading rubric)..."
                               required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Rejection" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         edu.exam.reevaluation.request — Views
         ═══════════════════════════════════════════════════════════════════ -->

    <record id="view_edu_exam_reevaluation_form" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.request.form</field>
        <field name="model">edu.exam.reevaluation.request</field>
        <field name="arch" type="xml">
            <form string="Revaluation Request" duplicate="0">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-success"
                            invisible="state != 'pending'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger"
                            invisible="state != 'pending'"
                            groups="education_security.group_education_admin"/>
                    <button name="action_revaluate" type="object"
                            string="Revaluate" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="education_security.group_education_admin,education_security.group_education_teacher"/>
                    <button name="action_publish_result" type="object"
                            string="Publish Result" class="btn-success"
                            invisible="state != 'revaluated' or result_state == 'published'"
                            groups="education_security.group_education_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,revaluated"/>
                </header>
                <sheet>
                    <field name="result_state" invisible="1"/>
                    <widget name="web_ribbon" title="Re-Published" bg_color="text-bg-success"
                            invisible="state != 'revaluated' or result_state != 'published'"/>
                    <div class="oe_title">
                        <label for="name" class="text-muted small"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Exam &amp; Subject Details">
                            <field name="result_id" readonly="state != 'pending'"/>
                            <field name="exam_id" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="subject_id" readonly="1"/>
                        </group>
                        <group string="Student &amp; Marks Info">
                            <field name="enrollment_id" readonly="1"/>
                            <field name="student_name" readonly="1"/>
                            <field name="current_marks" readonly="1"/>
                            <field name="max_marks" readonly="1"/>
                            <field name="grade" readonly="1"/>
                        </group>
                    </group>
                    <group string="Student Reason">
                        <field name="reason" nolabel="1" readonly="state != 'pending'"/>
                    </group>
                    <group string="Admin Review &amp; Remarks">
                        <group>
                            <field name="admin_notes" placeholder="Enter review remarks or instructions…"/>
                        </group>
                        <group>
                            <field name="reviewed_by_id" readonly="1"/>
                            <field name="review_date" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_edu_exam_reevaluation_list" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.request.list</field>
        <field name="model">edu.exam.reevaluation.request</field>
        <field name="arch" type="xml">
            <list string="Revaluation Requests" duplicate="0"
                  decoration-warning="state == 'pending'"
                  decoration-info="state == 'approved'"
                  decoration-success="state == 'revaluated'"
                  decoration-danger="state == 'rejected'">
                <field name="result_state" invisible="1"/>
                <field name="name"/>
                <field name="student_name"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="current_marks" string="Original Marks"/>
                <field name="max_marks"/>
                <field name="grade"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'revaluated'"
                       decoration-danger="state == 'rejected'"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check text-success" invisible="state != 'pending'"
                        groups="education_security.group_education_admin"/>
                <button name="action_reject" type="object" string="Reject"
                        icon="fa-times text-danger" invisible="state != 'pending'"
                        groups="education_security.group_education_admin"/>
                <button name="action_revaluate" type="object" string="Revaluate"
                        icon="fa-pencil text-primary" invisible="state != 'approved'"/>
                <button name="action_publish_result" type="object" string="Publish Result"
                        icon="fa-bullhorn text-success"
                        invisible="state != 'revaluated' or result_state == 'published'"
                        groups="education_security.group_education_admin"/>
            </list>
        </field>
    </record>

    <record id="view_edu_exam_reevaluation_search" model="ir.ui.view">
        <field name="name">edu.exam.reevaluation.request.search</field>
        <field name="model">edu.exam.reevaluation.request</field>
        <field name="arch" type="xml">
            <search string="Search Revaluations">
                <field name="name"/>
                <field name="student_name"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Re-evaluated" name="revaluated" domain="[('state','=','revaluated')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <group>
                    <filter string="Exam" name="group_exam" context="{'group_by': 'exam_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_exam_reevaluation" model="ir.actions.act_window">
        <field name="name">Revaluation Requests</field>
        <field name="res_model">edu.exam.reevaluation.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_exam_reevaluation_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No revaluation requests found</p>
            <p>Student requests submitted from the portal will appear here for review and approval.</p>
        </field>
    </record>

</odoo>
