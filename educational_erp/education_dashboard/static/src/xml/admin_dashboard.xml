<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="education_dashboard.AdminDashboard">
        <!-- o_edu_admin_minimal scopes the reduced-color, no-hover styling
             added in dashboard.scss so it never affects other dashboards
             that reuse .o_edu_kpi / .o_edu_clickable / .o_edu_panel. -->
        <div class="o_edu_dashboard o_edu_admin_minimal p-3">
            <div t-if="state.loading" class="o_edu_loading text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <div class="mt-2">Loading dashboard…</div>
            </div>

            <t t-else="">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="mb-0"><i class="fa fa-tachometer me-2"/>Admin Dashboard</h2>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.load()">
                        <i class="fa fa-refresh me-1"/>Refresh
                    </button>
                </div>

                <!-- Core KPIs: five neutral cards, no per-card colors -->
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md">
                        <div class="o_edu_kpi o_edu_kpi_click" t-on-click="onStudents">
                            <div class="o_edu_kpi_val" t-esc="state.data.kpis.total_students"/>
                            <div class="o_edu_kpi_lbl">Active Students</div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="o_edu_kpi o_edu_kpi_click" t-on-click="onFaculty">
                            <div class="o_edu_kpi_val" t-esc="state.data.kpis.total_faculty"/>
                            <div class="o_edu_kpi_lbl">Faculty</div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="o_edu_kpi o_edu_kpi_warn o_edu_kpi_click" t-on-click="onApplications">
                            <div class="o_edu_kpi_val" t-esc="state.data.kpis.pending_applications"/>
                            <div class="o_edu_kpi_lbl">Pending Applications</div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="o_edu_kpi o_edu_kpi_warn o_edu_kpi_click" t-on-click="onFees">
                            <div class="o_edu_kpi_val" t-esc="state.data.kpis.fees_outstanding"/>
                            <div class="o_edu_kpi_lbl">Fees Outstanding</div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="o_edu_kpi">
                            <div class="o_edu_kpi_val"><t t-esc="state.data.kpis.attendance_rate"/>%</div>
                            <div class="o_edu_kpi_lbl">Attendance Rate</div>
                        </div>
                    </div>
                </div>

                <!-- Simple bar charts, one color, no per-segment styling -->
                <div class="row g-3 common">
                    <div class="col-12 col-lg-6">
                        <div class="o_edu_panel">
                            <h5>Active Students by Program</h5>
                            <t t-if="programBars.length">
                                <div class="o_edu_bar_row" t-foreach="programBars" t-as="b" t-key="b.label">
                                    <span class="o_edu_bar_lbl" t-esc="b.label"/>
                                    <div class="o_edu_bar_track">
                                        <div class="o_edu_bar_fill" t-attf-style="width:{{b.pct}}%"/>
                                    </div>
                                    <span class="o_edu_bar_val" t-esc="b.value"/>
                                </div>
                            </t>
                            <p t-else="" class="text-muted mb-0">No data.</p>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="o_edu_panel">
                            <h5>Applications Funnel</h5>
                            <div class="o_edu_bar_row" t-foreach="funnelBars" t-as="b" t-key="b.label">
                                <span class="o_edu_bar_lbl" t-esc="b.label"/>
                                <div class="o_edu_bar_track">
                                    <div class="o_edu_bar_fill" t-attf-style="width:{{b.pct}}%"/>
                                </div>
                                <span class="o_edu_bar_val" t-esc="b.value"/>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="o_edu_panel">
                            <h5>Exam Status</h5>
                            <div class="o_edu_bar_row" t-foreach="examBars" t-as="b" t-key="b.label">
                                <span class="o_edu_bar_lbl" t-esc="b.label"/>
                                <div class="o_edu_bar_track">
                                    <div class="o_edu_bar_fill" t-attf-style="width:{{b.pct}}%"/>
                                </div>
                                <span class="o_edu_bar_val" t-esc="b.value"/>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="o_edu_panel">
                            <h5>Attendance Breakdown</h5>
                            <div class="d-flex flex-wrap gap-3">
                                <div class="o_edu_chip"><b t-esc="state.data.attendance.present"/>
                                    Present</div>
                                <div class="o_edu_chip"><b t-esc="state.data.attendance.absent"/>
                                    Absent</div>
                                <div class="o_edu_chip"><b t-esc="state.data.attendance.late"/>
                                    Late</div>
                                <div class="o_edu_chip"><b t-esc="state.data.attendance.excused"/>
                                    Excused</div>
                                <div class="o_edu_chip">Total: <b t-esc="state.data.attendance.total"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- Scholarships: bar chart for counts, doughnut for money -->
                    <div class="col-12 col-lg-6" t-if="state.data.scholarships">
                        <div class="o_edu_panel">
                            <h5>Scholarships</h5>
                            <div class="o_edu_bar_row" t-foreach="scholarshipBars" t-as="b" t-key="b.label">
                                <span class="o_edu_bar_lbl" t-esc="b.label"/>
                                <div class="o_edu_bar_track">
                                    <div class="o_edu_bar_fill" t-attf-style="width:{{b.pct}}%"/>
                                </div>
                                <span class="o_edu_bar_val" t-esc="b.value"/>
                            </div>
                            <hr t-if="scholarshipHasChartData"/>
                            <div class="d-flex justify-content-center align-items-center gap-4" t-if="scholarshipHasChartData">
                                <div class="o_edu_chart_box o_edu_chart_box_sm">
                                    <canvas t-ref="scholarshipChart"/>
                                </div>

                                <div class="o_edu_chart_legend">
                                    <div class="o_edu_chip">Approved Amount: <b
                                            t-esc="state.data.kpis.total_approved_amount"/></div>
                                    <div class="o_edu_chip">Total Budget: <b
                                            t-esc="state.data.kpis.total_scholarship_budget"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hostel: div-bars for room counts, chart for bed occupancy -->
                    <div class="col-12 col-lg-6" t-if="state.data.hostel">
                        <div class="o_edu_panel">
                            <h5>Hostel Occupancy</h5>
                            <div class="o_edu_bar_row" t-foreach="hostelBars" t-as="b" t-key="b.label">
                                <span class="o_edu_bar_lbl" t-esc="b.label"/>
                                <div class="o_edu_bar_track">
                                    <div class="o_edu_bar_fill" t-attf-style="width:{{b.pct}}%"/>
                                </div>
                                <span class="o_edu_bar_val" t-esc="b.value"/>
                            </div>
                            <div class="d-flex flex-wrap gap-3 mt-2 mb-2">
                                <div class="o_edu_chip">Properties: <b t-esc="state.data.kpis.total_properties"/></div>
                                <div class="o_edu_chip">Amount Invoiced: <b
                                        t-esc="state.data.kpis.total_amount_invoiced"/></div>
                            </div>
                            <hr t-if="hostelHasChartData"/>
                            <div class="d-flex justify-content-center align-items-center gap-4"
                                 t-if="hostelHasChartData">
                                <div class="o_edu_chart_box o_edu_chart_box_sm">
                                    <canvas t-ref="hostelChart"/>
                                </div>
                                <div class="o_edu_chart_legend">
                                    <div class="o_edu_chip">
                                        Total Capacity:<b t-esc="state.data.kpis.total_beds"/>
                                    </div>
                                    <div class="o_edu_chip">
                                        Occupied Beds:<b t-esc="state.data.kpis.total_beds_occupied"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="o_edu_panel">
                            <h5>Applications Awaiting Review</h5>
                            <t t-if="state.data.recent_applications.length">
                                <div class="o_edu_list_row o_edu_kpi_click"
                                     t-foreach="state.data.recent_applications" t-as="a" t-key="a.id"
                                     t-on-click="() => this.openRecord('education.application', a.id)">
                                    <span t-esc="a.name"/>
                                    <span class="badge text-bg-light" t-esc="a.program"/>
                                </div>
                            </t>
                            <p t-else="" class="text-muted mb-0">Nothing pending.</p>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>