<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal home entry deliberately has no allocation count. -->
    <template id="portal_my_home_hostel" name="Portal My Home: Hostel"
              inherit_id="portal.portal_my_home" priority="42">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Hostel</t>
                <t t-set="url" t-value="'/my/hostel'"/>
                <t t-set="text">View your hostel accommodation and room details</t>
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_hostel" name="My Hostel Accommodation">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Hostel</t>
            </t>

            <div class="container mt-4">
                <t t-set="display_allocation" t-value="current_allocation or pending_allocation"/>
                <t t-if="not display_allocation">
                    <div class="alert alert-info text-center">
                        <i class="fa fa-info-circle me-2"/>
                        You do not currently have a hostel room allocation.
                    </div>
                </t>

                <t t-if="display_allocation">
                    <t t-set="room" t-value="display_allocation.room_id"/>
                    <div class="card shadow-sm border-0 mb-4">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
                            <div>
                                <h5 class="mb-1">
                                    <i class="fa fa-building me-2"/>My Accommodation
                                </h5>
                                <small>
                                    <t t-esc="display_allocation.property_id.name"/>
                                    <t t-if="display_allocation.property_id.block">
                                        — <t t-esc="display_allocation.property_id.block"/>
                                    </t>
                                </small>
                            </div>
                            <span t-attf-class="badge text-uppercase #{'bg-success' if display_allocation.state == 'confirmed' else 'bg-warning text-dark'}">
                                <t t-esc="dict(display_allocation._fields['state'].selection).get(display_allocation.state)"/>
                            </span>
                        </div>
                        <div class="card-body">
                            <t t-if="display_allocation.state == 'draft'">
                                <div class="alert alert-warning mb-4">
                                    <i class="fa fa-clock-o me-2"/>This room allocation is pending confirmation.
                                </div>
                            </t>
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Room Details</h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">Room Number</dt>
                                        <dd class="col-sm-7 fw-semibold"><t t-esc="room.room_no"/></dd>
                                        <dt class="col-sm-5">Room Type</dt>
                                        <dd class="col-sm-7"><t t-esc="room.room_type_id.name or '—'"/></dd>
                                        <dt class="col-sm-5">Capacity</dt>
                                        <dd class="col-sm-7"><t t-esc="room.capacity"/> bed(s)</dd>
                                        <dt class="col-sm-5">Room Status</dt>
                                        <dd class="col-sm-7">
                                            <span t-attf-class="badge #{'bg-danger' if room.state == 'maintenance' else 'bg-info'}">
                                                <t t-esc="dict(room._fields['state'].selection).get(room.state, room.state)"/>
                                            </span>
                                        </dd>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Allocation Details</h6>
                                    <dl class="row mb-0">
                                        <dt class="col-sm-5">From Date</dt>
                                        <dd class="col-sm-7"><t t-esc="display_allocation.date_from or '—'"/></dd>
                                        <dt class="col-sm-5">To Date</dt>
                                        <dd class="col-sm-7"><t t-esc="display_allocation.date_to or '—'"/></dd>
                                        <dt class="col-sm-5">Hostel Fee</dt>
                                        <dd class="col-sm-7"><t t-esc="'%.2f' % display_allocation.hostel_fee"/></dd>
                                        <dt class="col-sm-5">Available Beds</dt>
                                        <dd class="col-sm-7"><t t-esc="room.available_beds"/></dd>
                                        <dt class="col-sm-5">Fee Due</dt>
                                        <dd class="col-sm-7"><t t-esc="display_allocation.fee_due"/></dd>
                                    </dl>
                                </div>
                            </div>

                            <t t-if="room.amenity_ids">
                                <hr/>
                                <h6 class="text-uppercase text-muted small fw-bold mb-2">Amenities</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    <t t-foreach="room.amenity_ids" t-as="amenity">
                                        <span class="badge rounded-pill bg-light text-dark border">
                                            <i class="fa fa-check-circle text-success me-1"/>
                                            <t t-esc="amenity.name"/>
                                        </span>
                                    </t>
                                </div>
                            </t>

                            <t t-if="display_allocation.notes">
                                <hr/>
                                <h6 class="text-uppercase text-muted small fw-bold mb-2">Notes</h6>
                                <p class="mb-0"><t t-esc="display_allocation.notes"/></p>
                            </t>
                        </div>
                    </div>
                </t>

                <t t-if="previous_allocations">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="fa fa-history me-2"/>Previous Accommodations</h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Hostel</th>
                                        <th>Room</th>
                                        <th>Type</th>
                                        <th>From</th>
                                        <th>To</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="previous_allocations" t-as="allocation">
                                        <tr>
                                            <td>
                                                <t t-esc="allocation.property_id.name"/>
                                                <t t-if="allocation.property_id.block">
                                                    <small class="text-muted">(<t t-esc="allocation.property_id.block"/>)</small>
                                                </t>
                                            </td>
                                            <td><t t-esc="allocation.room_id.room_no"/></td>
                                            <td><t t-esc="allocation.room_id.room_type_id.name or '—'"/></td>
                                            <td><t t-esc="allocation.date_from or '—'"/></td>
                                            <td><t t-esc="allocation.date_to or '—'"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
