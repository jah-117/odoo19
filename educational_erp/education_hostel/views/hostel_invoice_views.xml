<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hostel_fee_invoice_status" model="ir.ui.view">
        <field name="name">account.move.list.custom</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="My Invoices" create="0">
                <field name="name" decoration-bf="1" decoration-danger="made_sequence_gap and state == 'posted'"
                       widget="char_with_placeholder_field_to_check" placeholder="/"/>
                <field name="invoice_partner_display_name"
                       groups="base.group_user" string="Student"/>
                <field name="allocation_id" string="Allocation"/>
                <field name="invoice_date" optional="show"
                       readonly="state != 'draft'" string="Invoice Date" decoration-warning="abnormal_date_warning"/>
                <field name="invoice_date_due" widget="remaining_days" optional="show"
                       invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'"/>
                <field name="amount_untaxed_in_currency_signed" string="Tax Excluded" sum="Total" optional="show"/>
                <field name="amount_total_in_currency_signed" string="Total" sum="Total" optional="show"
                       decoration-bf="1" decoration-warning="abnormal_amount_warning"/>
                <field name="currency_id" optional="hide" readonly="state in ['cancel', 'posted']"/>
                <field name="status_in_payment" string="Status" widget="badge"
                       decoration-info="status_in_payment == 'draft'"
                       decoration-danger="status_in_payment in ('blocked', 'cancel')"
                       decoration-muted="status_in_payment in ('posted', 'sent', 'partial')"
                       decoration-success="status_in_payment in ('in_payment', 'paid', 'reversed')"
                       invisible="payment_state == 'invoicing_legacy' or move_type == 'entry'" optional="show"/>
                <field name="allocation_state" string="Accommodation Status" widget="badge"
                       decoration-info="allocation_state == 'draft'"
                       decoration-muted="allocation_state == 'vacated'"
                       decoration-success="allocation_state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_edu_hostel_invoices_search" model="ir.ui.view">
        <field name="name">account.move.hostel.invoices.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Hostel Invoices">
                <field name="name" string="Invoice"/>
                <field name="partner_id" string="Student"/>
                <field name="allocation_id" string="Allocation"/>
                <field name="allocation_state" string="Allocation Status"/>
                <separator/>
                <filter
                        name="allocation_confirmed"
                        string="Confirmed"
                        domain="[('allocation_state', '=', 'confirmed')]"
                />
                <filter
                        name="allocation_draft"
                        string="Draft"
                        domain="[('allocation_state', '=', 'draft')]"
                />
                <filter
                        name="allocation_vacated"
                        string="Vacated"
                        domain="[('allocation_state', '=', 'vacated')]"
                />
                <separator/>
                <group>
                    <filter
                            name="group_allocation_state"
                            string="Allocation Status"
                            context="{'group_by': 'allocation_state'}"
                    />
                    <filter
                            name="group_allocation"
                            string="Allocation"
                            context="{'group_by': 'allocation_id'}"
                    />
                    <filter
                            name="group_student"
                            string="Student"
                            context="{'group_by': 'partner_id'}"
                    />
                </group>
            </search>
        </field>
    </record>


    <record id="action_edu_hostel_invoices" model="ir.actions.act_window">
        <field name="name">Hostel Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_hostel_invoices_search"/>
        <field name="view_id" ref="hostel_fee_invoice_status"/>
        <field name="domain">
            [('invoice_type','=','hostel_fee')]
        </field>
        <field name="context">
            {'search_default_allocation_confirmed': 1 }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Invoices of allocated students to hostel rooms
            </p>
        </field>
    </record>
</odoo>