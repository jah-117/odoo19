<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_create_hostel_invoice" model="ir.cron">
            <field name="name">Create Hostel Invoices</field>
            <field name="model_id" ref="model_edu_hostel_allocation"/>
            <field name="state">code</field>
            <field name="code">model._check_create_invoice()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_send_overdue_notification" model="ir.cron">
            <field name="name">Send OverDue Notification</field>
            <field name="model_id" ref="model_edu_hostel_allocation"/>
            <field name="state">code</field>
            <field name="code">model._send_overdue_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>