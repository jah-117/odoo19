<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_violation_type_tree" model="ir.ui.view">
            <field name="name">education.violation.type.list</field>
            <field name="model">education.violation.type</field>
            <field name="arch" type="xml">
                <list string="Violation Types">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_violation_type_form" model="ir.ui.view">
            <field name="name">education.violation.type.form</field>
            <field name="model">education.violation.type</field>
            <field name="arch" type="xml">
                <form string="Violation Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_violation_type" model="ir.actions.act_window">
            <field name="name">Violation Types</field>
            <field name="res_model">education.violation.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
