<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_disciplinary_action_tree" model="ir.ui.view">
            <field name="name">education.disciplinary.action.list</field>
            <field name="model">education.disciplinary.action</field>
            <field name="arch" type="xml">
                <list string="Disciplinary Actions">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_disciplinary_action_form" model="ir.ui.view">
            <field name="name">education.disciplinary.action.form</field>
            <field name="model">education.disciplinary.action</field>
            <field name="arch" type="xml">
                <form string="Disciplinary Action">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_disciplinary_action" model="ir.actions.act_window">
            <field name="name">Disciplinary Actions</field>
            <field name="res_model">education.disciplinary.action</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
