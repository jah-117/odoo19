<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="production_action" model="ir.actions.act_window">
        <field name="name">Production Menu</field>
        <field name="res_model">mrp.production.ext</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Production
            </p>
        </field>
    </record>

    <record id="prouction_view_list" model="ir.ui.view">
        <field name="name">mrp.production.ext.view.list</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="bom_id"/>
                <field name="quantity"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="production_view_form" model="ir.ui.view">
        <field name="name">mrp.production.ext.view.form</field>
        <field name="model">mrp.production.ext</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" class="oe_highlight" type="object" string="Confirm"
                            invisible="state != 'draft'"/>
                    <button name="action_start_production" class="oe_highlight" type="object" string="Start Production"
                            invisible="state != 'confirmed'"/>
                    <button name="action_consume_quantity" class="oe_highlight" type="object" string="Consume Materials"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                icon="fa-taxi"
                                name="action_open_orders">
                            <field string="Materials" name="material_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="bom_id"/>
                            <field name="quantity"/>
                        </group>
                        <notebook>
                            <page string="Material Lines">
                                <field name="material_line_ids"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="materials_view_list" model="ir.ui.view">
        <field name="name">mrp.production.material.line.view.list</field>
        <field name="model">mrp.production.material.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="required_qty"/>
                <field name="available_qty"/>
                <field name="consumed_qty"/>
            </list>
        </field>
    </record>
</odoo>