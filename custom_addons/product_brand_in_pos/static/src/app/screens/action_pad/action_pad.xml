<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <t t-name="product_brand_in_pos.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-out='props.actionName']" position="replace">
            <t t-if="props.partner and props.order.displayPrice > props.partner.credit_limit">
                 <button class="disabled pay pay-order-button button btn btn-primary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill"
                            t-att-class="{'col-3': showFastPaymentMethods}" t-on-click="props.actionToTrigger" t-out="props.actionName" />
            </t>
            <t t-else="">
                 <button class="pay pay-order-button button btn btn-primary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill"
                            t-att-class="{'col-3': showFastPaymentMethods}" t-on-click="props.actionToTrigger" t-out="props.actionName" />
            </t>
        </xpath>
    </t>
</template>