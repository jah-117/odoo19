<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_restriction" model="ir.ui.view">
        <field name="name">product.product.brand.form.view</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="id" invisible="1"/>
                <field name="restricted_product_ids" string="Restricted products" widget="many2many_tags" domain="[('id','!=',id)]"/>
<!--                <field name="restricted_inverse_id" string="Product Restricted by"/>-->
            </xpath>
        </field>
    </record>
     <record id="order_line_list_view-kk" model="ir.ui.view">
        <field name="name">sale.order.tags.form.view</field>
        <field name="model">sale.order</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="restricted_product_ids" string="Restricted products" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>