<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="employee_transfers_list_view" model="ir.ui.view">
        <field name="name">employee.transfers.list.view</field>
        <field name="model">employee.transfers</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="old_company_id"/>
                <field name="new_company_id"/>
                <field name="is_approved"/>
            </list>
        </field>
    </record>
    <record id="employee_transfers_form_view" model="ir.ui.view">
        <field name="name">employee.transfers.from.view</field>
        <field name="model">employee.transfers</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" class="oe_highlight" type="object"
                    invisible=""/>
                </header>
                <sheet>
                    <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="old_company_id"/>
                    </group>
                    <group>
                        <field name="new_company_id"/>
                        <field name="is_approved" readonly="1"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_employee_transfer" model="ir.actions.act_window">
        <field name="name">Transfers menu</field>
        <field name="res_model">employee.transfers</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="transfers_menu" name="Transfers"
              parent="hr.menu_hr_root" sequence="11" action="employee_transfer.action_employee_transfer"/>

</odoo>