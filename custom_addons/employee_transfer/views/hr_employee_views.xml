<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_transfer_view" model="ir.ui.view">
        <field name="name">hr.employee.transfer.view.inherit</field>
        <field name="model">hr.employee</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_user']" position="after">
                <button name="action_create_transfer_request" string="Transfer Employee" class="oe_highlight" type="object"/>
            </xpath>
        </field>
    </record>
</odoo>