<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="employee_transfer_company_rule" model="ir.rule">
            <field name="name">Own company transfers</field>
            <field name="model_id" ref="model_employee_transfers"/>
            <field name="domain_force">[('old_company_id', 'in', user.company_ids)]</field>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>