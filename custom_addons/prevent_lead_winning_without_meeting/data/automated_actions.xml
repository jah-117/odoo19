<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="action_prevent_lead_winning" model="ir.actions.server">
            <field name="name">prevent.lead.winning</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="path">prevent_lead_winning</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model._prevent_lead_winning(record)</field>
        </record>

        <record id="automation_rule_action_prevent_lead" model="base.automation">
            <field name="name">trigger lead winning on update</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="trigger">on_write</field>
            <field name="action_server_ids" eval="[(4, ref('action_prevent_lead_winning'))]"/>
        </record>
    </data>
</odoo>