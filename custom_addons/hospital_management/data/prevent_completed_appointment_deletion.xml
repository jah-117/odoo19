<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="prevent_completed_appointment_deletion" model="ir.actions.server">
            <field name="name">Prevent deletion of completed appointment</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="state">code</field>
            <field name="path">hospital_management</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model._prevent_deletion(record)</field>
        </record>

        <record id="automated_action_to_prevent_deletion" model="base.automation">
            <field name="name">Prevent deletion</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="trigger">on_unlink</field>
            <field name="action_server_ids" eval="[(4, ref('prevent_completed_appointment_deletion'))]"/>
        </record>
    </data>
</odoo>