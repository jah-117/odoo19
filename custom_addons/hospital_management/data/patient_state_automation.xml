<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="change_patient_state" model="ir.actions.server">
            <field name="name">Discharge patient</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="state">code</field>
            <field name="path">hospital_management_patient</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model._change_patient_state(record)</field>
        </record>

        <record id="automated_patient_state" model="base.automation">
            <field name="name">Discharge Patient when all appointments are completed</field>
            <field name="model_id" ref="hospital_management.model_hospital_appointment"/>
            <field name="trigger">on_create_or_write</field>
            <field name="action_server_ids" eval="[(4, ref('change_patient_state'))]"/>
        </record>
    </data>
</odoo>