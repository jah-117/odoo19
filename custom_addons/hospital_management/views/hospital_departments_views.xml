<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_hospital_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Departments
            </p>
        </field>
    </record>

    <record id="department_form_view" model="ir.ui.view">
        <field name="name">hospital.department.form.view</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="doctor_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="department_list_view" model="ir.ui.view">
        <field name="name">hospital.department.list.view</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="doctor_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
</odoo>