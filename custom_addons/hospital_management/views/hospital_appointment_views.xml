<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Appointments
            </p>
        </field>
    </record>

    <record id="appointment_form_view" model="ir.ui.view">
        <field name="name">hospital.appointment.form.view</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <field name="available_doctor_ids" invisible="1"/>
                <header>
                    <button name="action_schedule" string="Schedule Appointment" class="oe_highlight" type="object" invisible="state != 'draft'"/>
                    <button name="action_consultation" string="Start Consultation" class="oe_highlight" type="object" invisible="state != 'scheduled'"/>
                    <button name="action_completed" string="Complete Consultation" class="oe_highlight" type="object" invisible="state != 'consultation'"/>
                    <button name="action_cancelled" string="Cancel Appointment"  type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="department_id"/>
                            <field name="doctor_id" domain="[('id','in',available_doctor_ids)]"/>

                        </group>
                        <group>
                            <field name="appointment_datetime"/>
                            <field name="consultation_fee"/>
                            <field name="medicine_total"/>
                            <field name="total_bill"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Symptoms">
                            <field name="symptoms"/>
                        </page>
                        <page string="Diagnosis">
                            <field name="diagnosis"/>
                        </page>
                        <page string="Prescription">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="dosage"/>
                                    <field name="days"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="appointment_list_view" model="ir.ui.view">
        <field name="name">hospital.appointment.list.view</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>
</odoo>