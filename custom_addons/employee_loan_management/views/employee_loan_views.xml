<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="employee_loan_action" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="employee_loan_list_view" model="ir.ui.view">
        <field name="name">employee_loan.list.view</field>
        <field name="model">employee.loan</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Structure Type">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_amount"/>
                <field name="installment_count"/>
                <field name="start_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="employee_loan_form_view" model="ir.ui.view">
        <field name="name">employee_loan.form.view</field>
        <field name="model">employee.loan</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Loans">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate_installment" type="object" string="Generate Installment" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_pay_installment" type="object" string="Pay Installment" class="oe_highlight" invisible="state != 'ongoing'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                icon="fa-bars"
                                name="action_open_lines">
                            <field string="Open Lines" name="line_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="loan_amount" readonly="state != 'draft'"/>
                            <field name="installment_count" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="state != 'draft'" />
                            <field name="installment_amount" readonly="state != 'draft'"/>
                            <field name="total_payable" />
                            <field name="paid_amount"/>
                            <field name="balance_amount"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Loan lines">
                            <field name="loan_line_ids" readonly="1">
                                <list string="Loan Lines" editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="paid"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>