<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="leave_approved_mail" model="mail.template">
            <field name="name">leave.approved.mail</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="use_default_to">False</field>
            <field name="email_to">{{object.employee_id.email}}</field>
            <field name="subject">You leave has approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Hi,
                            <t t-out="object.employee_id.name"/>
                        </h2>
                        <div>
                            <h3>
                                This mail is to inform you that your leave
                                has approved
                            </h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
            </field>
        </record>
        <record id="leave_refused_mail" model="mail.template">
            <field name="name">leave.refused.mail</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="use_default_to">False</field>
            <field name="email_to">{{object.employee_id.email}}</field>
            <field name="subject">You leave has refused</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Hi,
                            <t t-out="object.employee_id.name"/>
                        </h2>
                        <div>
                            <h3>
                                This mail is to inform you that your leave
                                has refused
                            </h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    Regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
            </field>
        </record>
    </data>
</odoo>