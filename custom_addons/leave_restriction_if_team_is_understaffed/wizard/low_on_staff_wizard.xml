<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="low_on_staff_wizard" model="ir.ui.view">
        <field name="name">low.on.staff.wizard.view</field>
        <field name="model">low.on.staff.wizard</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <div>
                        <div>
                           <h3 class="pt-3"><field name="message" no_label="1" readonly="1"/></h3>
                        </div>
                    </div>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button name="action_refuse" string="Refuse" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>