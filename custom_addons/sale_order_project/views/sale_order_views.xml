<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_project_inherited_view" model="ir.ui.view">
        <field name="name">sale.order.project.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="create_task" string="Create Task" type="object" invisible="create_invisible"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="available_project_ids" invisible="1"/>
                <field name="create_invisible" invisible="1"/>
                <field name="task_id" invisible="1"/>
                <field name="subtask_ids" invisible="1"/>
                <field name="project_id" domain="[('id','in',available_project_ids)]"
                       context="{'default_partner_id':partner_id}"/>
            </xpath>
            <xpath expr="//button[@name='action_view_invoice']" position="after">
                <button name="%(project.project_task_action_sub_task)d"
                        type="action"
                        context="{'subtask_action': True, 'task_ids':subtask_ids, 'task_id':task_id}"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="subtask_count == 0">
                    <field name="subtask_count" widget="statinfo" string="Sub Tasks"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>