<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="automate_po_wizard_view" model="ir.ui.view">
        <field name="name">automate.po.wizard.view.form</field>
        <field name="model">automate.po.wizard</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="unit_cost"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_po" string="Confirm" type="object" class="oe_highlight"  context="{'send_rfq':True}"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>