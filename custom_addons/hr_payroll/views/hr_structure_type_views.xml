<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="structure_type_action" model="ir.actions.act_window">
        <field name="name">Structure Types</field>
        <field name="res_model">hr.payroll.structure.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="structure_type_list_view" model="ir.ui.view">
        <field name="name">structure.type.list.view</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Structure Type">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="country_code" column_invisible="1"/>
                <field name="default_resource_calendar_id"/>
                <field name="wage_type"/>
                <field name="default_struct_id"/>
            </list>
        </field>
    </record>
    <record id="structure_type_form_view" model="ir.ui.view">
        <field name="name">structure.type.form.view</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Structure Type">
                <sheet>
<!--                    <div class="oe_button_box" name="button_box">-->
<!--                        <button class="oe_stat_button" icon="calculate" type="action" name="1848">-->
<!--                            <field string="Structures" name="struct_type_count" widget="statinfo"/>-->
<!--                        </button>-->
<!--                    </div>-->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Employee" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="country_code" invisible="1"/>
                            <field name="wage_type"/>
                        </group>
                        <group>
                            <field name="default_resource_calendar_id"/>
                            <field name="default_struct_id"/>
                            <field name="default_work_entry_type_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>