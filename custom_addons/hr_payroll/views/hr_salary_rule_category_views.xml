<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_rule_category_action" model="ir.actions.act_window">
        <field name="name">Rule Category</field>
        <field name="res_model">hr.salary.rule.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="rule_category_list_view" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.list.view</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Salary Rule Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id" column_invisible="True"/>
                <field name="country_id"/>
                <field name="salary_rule_ids"/>
                <button name="action_open_salary_rules" type="object" icon="open_in_new" string="Salary Rules"
                        invisible="not salary_rule_ids"/>
            </list>
        </field>
    </record>
    <record id="rule_category_form_view" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form.view</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Salary Categories">
                <sheet>
                    <group>
                        <group name="category_details" col="4">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>