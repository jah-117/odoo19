<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_payroll_payslips" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="payslips_list_view" model="ir.ui.view">
        <field name="name">hr.payslip.list.view</field>
        <field name="model">hr.payslip</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Payslips" default_order="state_display, employee_id" edit="1" sample="1" multi_edit="1" duplicate="0">
                <header>
                    <button string="Validate" name="action_validate" type="object" class="oe_highlight" context="{'payslip_generate_pdf': True}"/>
                    <button string="Compute" name="compute_sheet" type="object" class="oe_highlight"/>
                    <button string="Mark as Paid" name="action_payslip_paid" type="object" class="oe_highlight"/>
                    <button string="Print" name="action_print_payslip" type="object"/>
                </header>
                <field name="company_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="employee_id" widget="many2one_avatar_employee" width="300" readonly="state != 'draft'"/>
<!--                <field name="issues" width="600" widget="actionable_warnings" string="" optional="hide" options="{'payrun_optional': 'show'}"/>-->
                <field name="date_from" string="Period" widget="daterange" options="{'end_date_field': 'date_to', 'payrun_optional': 'hide'}" readonly="1"/>
                <field name="date_to" invisible="1" column_invisible="1" readonly="1"/>
<!--                <field name="payslip_run_id" optional="show" widget="many2one" readonly="state != 'draft'" options="{'payrun_optional': 'hide', 'no_open': 0}" placeholder="Off-Cycle"/>-->
                <field name="struct_id" optional="hide" readonly="state in ['cancel', 'validated', 'paid']"/>
                <field name="company_id" options="{'no_create': True}" optional="hide"/>
<!--                <field name="sum_worked_days" optional="show"/>-->
<!--                <field name="sum_worked_hours" optional="hide"/>-->
<!--                <field name="employer_cost" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" sum="Total Cost"/>-->
                <field name="basic_wage" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" sum="Total Basic"/>
<!--                <field name="gross_wage" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" sum="Total Gross"/>-->
<!--                <field name="payslip_properties"/>-->
<!--                <field name="net_wage" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" optional="show" sum="Total Net"/>-->
                <field name="state_display" widget="badge" decoration-info="state_display == '03_draft'" decoration-success="state_display == '04_validated'" decoration-primary="state_display == '05_paid'" decoration-warning="state_display == '02_warning'" decoration-danger="state_display == '01_error'"/>
<!--                <button string="Off-Cycle" help="Detach the payslip from the pay run to send it to the Off-Cycle" name="action_move_to_off_cycle" type="object" icon="fa-long-arrow-right" invisible="not (payslip_run_id and state_display in ['03_draft', '02_warning', '01_error'])"/>                -->
            </list>
        </field>
    </record>
    <record id="payslips_form_view" model="ir.ui.view">
        <field name="name">hr.payslip.form.view</field>
        <field name="model">hr.payslip</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Payslip" duplicate="0">
            <header>
                <button string="Validate" name="action_payslip_done" type="object" invisible="state != 'draft' or not line_ids" class="oe_highlight" context="{'payslip_generate_pdf': True}"/>
                <button string="Pay" name="action_payslip_payment_report" type="object" class="oe_highlight" invisible="state != 'validated'"/>
                <button string="Revert" name="refund_sheet" type="object" invisible="state != 'paid'" confirm="Are you sure you want to revert this payslip? This will create a negative of this payslip."/>
                <button string="Revert" name="refund_sheet" type="object" invisible="state != 'paid'" confirm="Another refund payslip with the same amount has been found. Do you want to create a new one?"/>
                <button string="Set to Draft" name="action_payslip_draft" type="object" invisible="state != 'cancel'"/>
                <button string="Unpaid" name="action_payslip_unpaid" type="object" invisible="state != 'paid'"/>
                <button string="Compute" name="compute_sheet" type="object" invisible="state != 'draft' or line_ids" class="oe_highlight" help="Recompute the payslip lines only, not the worked days / input lines"/>
                <button string="Compute" name="compute_sheet" type="object" invisible="state != 'draft' or not line_ids" help="Recompute the payslip lines only, not the worked days / input lines"/>
                <button string="Print" name="action_print_payslip" type="object" invisible="not line_ids"/>
                <button string="Cancel" name="action_payslip_cancel" type="object" invisible="state not in ('draft', 'validated')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,validated,paid"/>
            </header>
<!--            <field name="issues" class="w-100" widget="actionable_warnings" invisible="not issues"/>-->
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button type="object" class="oe_stat_button" name="action_open_related_payslips" id="open_related_payslips" icon="fa-files-o" invisible="related_payslip_count == 0">
                        <field name="related_payslip_count" widget="statinfo" string="Related Payslips"/>
                    </button>
                    <button type="object" class="oe_stat_button" name="action_open_salary_attachments" id="open_salary_attachments" icon="fa-files-o" invisible="salary_attachment_count == 0">
                        <field name="salary_attachment_count" widget="statinfo" string="Salary Adjustments"/>
                    </button>
                </div>
                <div class="d-flex flex-column-reverse flex-sm-row align-items-sm-start gap-3 gap-md-5 mb-3 mb-lg-0">
                    <div name="employee_structure_widget" class="oe_title flex-grow-1">
                        <h1 class="d-flex flex-row align-items-center mb-1">
                            <field name="employee_id" widget="many2one_avatar_employee" placeholder="Employee" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </h1>
                        <div class="d-block w-100 mb-2">
                            <field name="struct_id" class="w-100 d-block" required="1" readonly="state in ['cancel', 'validated', 'paid']" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" placeholder="Select the pay structure"/>
                        </div>
                    </div>
                    <div name="payslip_summary_widget" class="d-flex flex-grow-1 gap-2 justify-content-end">
                        <div class="flex-basis-50 flex-basis-sm-auto bg-100 p-2 px-lg-4 border rounded text-center" invisible="ignore_worked_day_lines">
                            <div class="mb-2 fw-bold">Worked days</div>
                            <div class="fs-2 lh-1">
<!--                                <field name="sum_worked_days" nolabel="1" class="mb-1 me-1"/>days-->
                            </div>
                            <div class="text-muted">
<!--                                <field name="sum_worked_hours" widget="float_time" nolabel="1"/>-->
                            </div>
                        </div>
                        <div class="flex-basis-50 flex-basis-sm-auto bg-100 p-2 px-lg-4 border rounded text-center">
                            <div class="mb-2 fw-bold">Wage</div>
                            <div class="o_row" invisible="ignore_worked_day_lines">
                                <field name="basic_wage" nolabel="1" class="justify-content-center mb-1 fs-2 lh-1"/>
                            </div>
                            <div class="text-muted" invisible="ignore_worked_day_lines">
                                <field name="net_wage" nolabel="1"/>
                                <span class="text-muted ms-1">Net</span>
                            </div>
                            <div class="text-muted" invisible="not ignore_worked_day_lines">
                                <field name="net_wage" nolabel="1" class="justify-content-center mb-1 fs-2 lh-1"/>
                                <span class="text-muted ms-1">Net</span>
                            </div>
                        </div>
                    </div>
                </div>
                <group name="top">
                    <group name="top_left">
                        <field name="company_id" invisible="1"/>
                        <field name="version_id" context="{'default_employee_id': employee_id, 'list_view_ref': 'hr_payroll.hr_version_list_search_more_view'}" required="1" readonly="state in ['cancel', 'validated', 'paid']" string="Employee Record" invisible="not employee_id &lt;= 1" domain="[('employee_id', '=', employee_id),                                 ('date_start', '&lt;=', date_to),                                 '|',                                     ('date_end', '=', False),                                     ('date_end', '&gt;=', date_from)                             ]" options="{                                 'no_create': True,                                 'no_create_edit': True,                             }"/>
                        <field name="country_id" invisible="1"/>
                        <field name="country_code" invisible="1"/>
<!--                        <field name="payslip_run_id" string="Pay Run" placeholder="Off-Cycle" context="{'default_date_start': date_from, 'default_date_end': date_to}" options="{'no_create': True, 'no_create_edit': True}"/>-->
                        <field name="salary_attachment_ids" invisible="1" force_save="1"/>
                        <field name="sum_worked_hours" invisible="1"/>
<!--                        <field name="credit_note" invisible="1" readonly="state != 'draft'"/>-->
<!--                        <field name="is_superuser" invisible="1"/>-->
<!--                        <field name="ignore_worked_day_lines" invisible="1"/>-->
<!--                        <field name="payment_report_filename" invisible="1"/>-->
<!--                        <field name="payment_report" filename="payment_report_filename" invisible="not payment_report"/>-->
                        <label for="date_from" string="Period"/>
                        <div name="period">
                            <field name="date_from" class="oe_inline" readonly="state in ['cancel', 'validated', 'paid']"/>
                            <i class="oi oi-arrow-right px-2"/>
                            <field name="date_to" class="oe_inline" readonly="state in ['cancel', 'validated', 'paid']"/>
                        </div>
                    </group>
                </group>
                <notebook>
                    <field name="country_code" invisible="1"/>
                    <page string="Worked Days" name="worked_days" class="o_hr_payroll_worked_days" invisible="ignore_worked_day_lines">
                        <field name="worked_days_line_ids" readonly="state in ['cancel', 'validated', 'paid']">
                            <list string="Worked Days" editable="bottom" create="0" delete="0">
                                <field name="work_entry_type_id" readonly="1" force_save="1"/>
                                <field name="version_id" readonly="1" force_save="1"/>
                                <field name="name"/>
                                <field name="number_of_days" sum="Total Working Days" force_save="1" string="Days"/>
                                <field name="number_of_hours" widget="float_time" sum="Total Working Hours" force_save="1" string="Hours"/>
                                <field name="amount" sum="Total Amount" force_save="1" column_invisible="parent.country_code in ['AE', 'SA']"/>
                                <field name="ytd" readonly="1" force_save="1" column_invisible="not parent.ytd_computation" optional="show"/>
                                <field name="is_paid" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                    <page string="Salary Inputs" class="o_hr_payroll_worked_days" name="salary_inputs">
                        <field name="input_line_ids" colspan="4" nolabel="1" readonly="state in ['cancel', 'validated', 'paid']">
                            <list string="Input Data" editable="bottom">
                                <!--
                                    Required 0 to force client to send on change request even when not defined
                                    Salary Attachments would otherwise not properly be computed and payslip_id is
                                    required for _allowed_input_type_ids to work..
                                -->
                                <field name="payslip_id" required="0" column_invisible="True"/>
                                <field name="_allowed_input_type_ids" column_invisible="True"/>
                                <field name="input_type_id"/>
                                <field name="name" string="Note"/>
                                <field name="amount" widget="float_without_trailing_zeros"/>
                                <field name="version_id" column_invisible="True"/>
                                <field name="sequence" column_invisible="True"/>
                            </list>
                        </field>
                        <field name="currency_id" invisible="1"/>
<!--                        <field name="payslip_properties" widget="properties" readonly="state != 'draft'"/>-->
                    </page>
                    <page string="Salary Computation" name="salary_computation" class="o_hr_payroll_salary_computation">
                        <field name="line_ids" colspan="4" nolabel="1" readonly="state != 'draft'">
                            <list string="Salary Structure" editable="bottom" decoration-info="total == 0" create="0" delete="0">
                                <field name="name"/>
                                <field name="code" readonly="1" force_save="1" optional="hide"/>
                                <field name="category_ids" widget="many2many_tags" readonly="1" force_save="1" optional="hide"/>
                                <field name="sequence" readonly="1" column_invisible="True" force_save="1"/>
                                <field name="quantity" force_save="1" optional="show"/>
                                <field name="rate" force_save="1" optional="show"/>
                                <field name="salary_rule_id" readonly="1" force_save="1" optional="hide"/>
                                <field name="amount" force_save="1" optional="show"/>
                                <field name="total" readonly="1" force_save="1"/>
                                <field name="ytd" readonly="1" force_save="1" column_invisible="not parent.ytd_computation" optional="show"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                    <page string="Other Info" name="account_info">
                        <group>
                            <group>
                                <field name="name" invisible="1"/>
                                <field name="title" placeholder="Default" readonly="state in ['cancel', 'validated', 'paid']"/>
                                <field name="ignore_worked_day_lines" readonly="state in ['cancel', 'validated', 'paid']" string="No Worked Days" invisible="not struct_use_worked_day_lines"/>
                                <div colspan="2">
                                    <label for="note" string="Note"/>
                                    <field name="note" class="oe_inline" placeholder="Add a note on the printed payslip." readonly="state != 'draft'"/>
                                </div>
                            </group>
                            <group name="accounting">
                                <field name="paid_date"/>
                                <field name="paid" invisible="1" readonly="state != 'draft'"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>