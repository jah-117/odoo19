<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="structure_action" model="ir.actions.act_window">
        <field name="name">Structures</field>
        <field name="res_model">hr.payroll.structure</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="structure_list_view" model="ir.ui.view">
        <field name="name">structure.list.view</field>
        <field name="model">hr.payroll.structure</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Employee Function">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_id" column_invisible="True"/>
                <field name="rule_ids"/>
                <field name="country_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>
    <record id="structure_form_view" model="ir.ui.view">
        <field name="name">structure.form.view</field>
        <field name="model">hr.payroll.structure</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
           <form string="Employee Function">
            <sheet>
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                <div class="oe_title">
                    <label for="name" string="Structure Name"/>
                    <h1><field name="name" placeholder="e.g. Regular Pay"/></h1>
                </div>
                <group>
                    <group name="salary_details">
                        <field name="active" invisible="1"/>
                        <field name="id" invisible="1"/>
                        <field name="employee_type_ids" widget="many2many_tags" placeholder="All types"/>
                        <field name="type_id"/>
                        <field name="use_worked_day_lines"/>
                        <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="ytd_computation"/>
                    </group>
                    <group>
                        <field name="report_id"/>
                        <field name="payslip_name"/>
                        <field name="hide_basic_on_pdf"/>
                    </group>
                </group>
                <notebook colspan="4">
                    <page name="salary_rules" string="Salary Rules">
                        <field name="rule_ids" readonly="not id">
                            <list>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="category_ids" widget="many2many_tags"/>
                                <field name="sequence" column_invisible="True"/>
                            </list>
                        </field>
                    </page>
                    <page string="Unpaid Time Types" name="unpaid_work_entry_types">
                        <field name="unpaid_work_entry_type_ids"/>
                    </page>
                    <page name="other_input" string="Other Input">
                        <field name="input_line_type_ids">
                            <list>
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            </form>
        </field>
    </record>
</odoo>