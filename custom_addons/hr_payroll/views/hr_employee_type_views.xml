<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_contract_type_action" model="ir.actions.act_window">
        <field name="name">Employee Types</field>
        <field name="res_model">hr.employee.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Employee Types
            </p>
        </field>
    </record>

    <record id="hr_contract_type_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.type list</field>
        <field name="type">list</field>
        <field name="model">hr.employee.type</field>
        <field name="arch" type="xml">
            <list string="Employee Types">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="country_id"/>
                <field name="payroll_closing_date"/>
                    <field name="employees_count" string="Employees"/>
                    <button name="action_open_employees" type="object" string="View Employees" invisible="not employees_count" class="btn-link"/>
                    <field name="company_id" groups="hr.group_hr_user" optional="hide"/>
                    <field name="code" column_invisible="1"/>
                </list>
        </field>
    </record>
    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.employee.type form</field>
        <field name="type">form</field>
        <field name="model">hr.employee.type</field>
        <field name="arch" type="xml">
            <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" on_change="1"/>
                                <field name="code" invisible="1"/>
                                <field name="country_id" can_create="True" can_write="True"/>
                <field name="payroll_closing_date"/>
                <field name="payroll_auto_post"/>
                            </group>
                        </group>
                    </sheet>
                </form>
        </field>
    </record>
</odoo>