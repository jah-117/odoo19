     <record id="hotel_management_report_view" model="ir.actions.act_window">
        <field name="name">Hotel Management Report</field>
        <field name="res_model">hotel.management.report</field>
        <field name="path">hotel-accommodation-analysis</field>
        <field name="view_mode">form</field>
<!--        <field name="context">{'search_default_current':1, 'search_default_customer': 1, 'group_by':['invoice_date:month']}</field>-->
<!--        <field name="search_view_id" ref="view_hotel_accommodation_search"/>-->
         <field name="target">new</field>
         <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No data to create report
            </p>
         </field>
    </record>
    <record id="view_hotel_accommodation_form" model="ir.ui.view">
         <field name="name">hotel.management.report.form</field>
         <field name="model">hotel.management.report</field>
<!--        <field name="target">new</field>-->
         <field name="arch" type="xml">
             <form string="Hotel Management Report">
                 <sheet>
                     <group>
                     <group>
                         <field name="guest_name"/>
                     </group>
                     <group>
                         <field name="date_from"/>
                         <field name="date_to"/>
                     </group>
                 </group>
                 </sheet>
                 <footer>
                     <button name="generate_report" string="Generate" class="oe_highlight" type="object"/>
                     <button special="cancel" string="Cancel"/>
                 </footer>
             </form>
         </field>
    </record>
