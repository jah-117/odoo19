<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

     <record id="hotel_management_report_view" model="ir.actions.act_window">
        <field name="name">Hotel Management Report</field>
        <field name="res_model">hotel.management.report</field>
        <field name="path">hotel-accommodation-analysis</field>
        <field name="view_mode">form</field>
         <field name="target">new</field>
         <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No data to create report
            </p>
         </field>
    </record>
    <record id="view_hotel_accommodation_form" model="ir.ui.view">
         <field name="name">hotel.management.report.form</field>
         <field name="model">hotel.management.report</field>
         <field name="arch" type="xml">
             <form string="Hotel Management Report">
                 <sheet>
                     <group>
                     <group>
                         <field name="guest_name"/>
                     </group>
                     <group>
                         <field name="date_from"/>
                         <field name="date_to"/>
                     </group>
                 </group>
                 </sheet>
                 <footer>
                     <button name="generate_report" string="Generate PDF" class="oe_highlight" type="object"/>
                     <button name="generate_xlsx" string="Generate XLS" class="oe_highlight" type="object"/>
                     <button name="generate_sale_order" string="Sales Report" class="oe_highlight" type="object"/>
                     <button special="cancel" string="Cancel"/>
                 </footer>
             </form>
         </field>
    </record>
</odoo>