<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<template  xml:space="preserve">
    <t t-name="hotel_management.item_card">
        <div class="item-card">
            <t t-foreach="items" t-as="item" t-key="item.id">
                <div class="col">
                    <div class="card h-100">
                        <img t-att-src="item.image" class="card-img-top" t-att-alt="item.item"/>
                        <div class="card-body">
                            <h5 class="card-title"><t t-esc="item.name"/> </h5>
                            <p class="card-text">
                                <t t-esc="item.description"/><br/>
                                Available quantity = <t t-esc="item.available_quantity"/>
                            </p>
                            <button t-att-data-item_id="item.id" class="add_to_cart btn btn-primary">Add to Cart - <t t-esc="item.price"/>$</button>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</template>

</odoo>