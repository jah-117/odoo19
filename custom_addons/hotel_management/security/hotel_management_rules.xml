<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hotel_accommodation_company_rule" model="ir.rule">
            <field name="name">Hotel Management multi company</field>
            <field name="model_id" ref="model_hotel_accommodation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4,ref('group_hotel_receptionist'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>