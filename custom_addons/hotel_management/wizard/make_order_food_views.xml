<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="order_food_transient_view" model="ir.ui.view">
        <field name="name">make.order.food.wizard</field>
        <field name="model">make.order.food</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form class="flex-column">
                <div class="d-flex">
                    <div class="flex-grow-0 pe-5">
                        <field name="image" widget="image" class="o_lunch_image" options="{'image_preview': 'image'}"/>
                    </div>
                    <div class="flex-grow-1 pe-5">
                        <h2><field name="name" on_change="1"/></h2>
                        <h3 class="pt-3"><field name="price" widget="monetary"/></h3>
                    </div>
                </div>
                <div class="row">
                        <div class="o_td_label col-3 col-md-2">
                            <label for="quantity" class="o_form_label"/>
                        </div>
                        <div class="col-9 col-md-10">
                            <field name="quantity" nolabel="1" placeholder="Quantity of item" class="o_field_widget o_quick_editable" on_change="1"/>
                            /
                            <field name="available_quantity" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                <footer>
                    <button name="add_to_list" string="Add to List" type="object" class="btn-primary"/>
                    <button name="button_discard" string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>