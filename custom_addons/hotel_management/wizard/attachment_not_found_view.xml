<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="attachement_not_found_view" model="ir.ui.view">
        <field name="name">accommodation.attachment.warning</field>
        <field name="model">attachment.warning</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form>
                <div>
                    No attached files found, Please attach your ID-Proof!
                </div>
                <footer>
                    <button name="button_attach" string="Attach" type="object" class="btn-primary"/>
                    <button name="button_continue" string="Continue" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
                </field>
    </record>
</odoo>