<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_fooditems" model="ir.actions.act_window">
        <field name="name">Food Items</field>
        <field name="res_model">food.items</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Facility
            </p>
        </field>
    </record>

    <record id="fooditems_view_list" model="ir.ui.view">
        <field name="name">food.items.view.list</field>
        <field name="model">food.items</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="item"/>
                <field name="category_id"/>
                <field name="quantity"/>
                <field name="price"/>
            </list>
        </field>
    </record>
    <record id="fooditems_view_form" model="ir.ui.view">
        <field name="name">food.items.view.form</field>
        <field name="model">food.items</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="item"/>
                            <field name="quantity"/>
                            <field name="currency_id" invisible="1" />
                            <field name="price" widget="monetary"/>

                        </group>
                        <group>
                            <field name="description"/>
                            <field name="image"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fooditems_view_kanban" model="ir.ui.view">
        <field name="name">food.items.view.kanban</field>
        <field name="model">food.items</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <template>
                    <t t-name="card">
                        <div>
                            <field name="name"/>
<!--                            <field name="item"/>-->
<!--                            <field name="quantity"/>-->
<!--                            <field name="price"/>-->

                        </div>
                        <div>
                            <field name="description"/>
<!--                            <field name="image"/>-->
<!--                            <field name="category_id"/>-->
                        </div>
                    </t>
                </template>
            </kanban>
        </field>
    </record>
</odoo>