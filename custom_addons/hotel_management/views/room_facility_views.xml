<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_facilities" model="ir.actions.act_window">
        <field name="name">Facility</field>
        <field name="res_model">room.facility</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Facility
            </p>
        </field>
    </record>

    <record id="facilty_view_list" model="ir.ui.view">
        <field name="name">room.facility.view.list</field>
        <field name="model">room.facility</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>





    <record id="action_accommodations" model="ir.actions.act_window">
        <field name="name">Accommodations</field>
        <field name="res_model">hotel.accommodation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Accommodations
            </p>
        </field>
    </record>

    <record id="hotel_accommodation_view_form" model="ir.ui.view">
        <field name="name">hotel.accommodation.view.form</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,check_in,check_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" decoration-bf="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="guest"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..."/>
                            <field name="number_of_guests" string="Number of Guests" default="1"/>
                            <field name="other_guests" string="Other guests" widget="many2many_tags"
                                   invisible="number_of_guests == 1"/>
                        </group>
                        <group>
                            <field name="bedType" string="Bed Type"/>
                            <field name="check_in" string="Check-In Time"/>
                            <field name="check_out" string="Check-Out Time"/>
                            <field name="facilities" string="Facilities" widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="room" string="Room" widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="id_proof" string="ID Proof"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="hotel_accommodation_view_list" model="ir.ui.view">
        <field name="name">hotel.accommodation.view.list</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="bedType" string="Bed Type"/>
            </list>
        </field>
    </record>
</odoo>