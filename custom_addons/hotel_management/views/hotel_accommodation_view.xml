<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_accommodations" model="ir.actions.act_window">
        <field name="name">Accommodations</field>
        <field name="res_model">hotel.accommodation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open_records': 1,'search_default_expected_current_day':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Accommodations
            </p>
        </field>
    </record>

    <record id="hotel_accommodation_view_form" model="ir.ui.view">
        <field name="name">hotel.accommodation.view.form</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <form>

                <field name="id_proofs" invisible="1"/>
                <field name="available_room_ids" invisible="1"
                       domain="[('state','=','available'),('bed','=',bed_type)]"/>
                <header>
                    <button name="check_in_guest" type="object" class="oe_highlight" string="Check-In"
                            invisible="state != 'draft'"/>
                    <button name="check_out_guest" type="object" class="oe_highlight" string="Check-Out"
                            invisible="state != 'check_in'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,check_in,check_out"/>
                </header>
                <sheet>
                    <div name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success"
                            invisible="payment_state != 'paid'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" decoration-bf="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="guest"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True,'default_is_hotel_guest':True}"
                                   placeholder="Type to find a customer..."/>
                            <field name="number_of_guests" string="Number of Guests" default="1"/>
                            <field name="expected_days" string="Expected days" default="1"
                                   invisible="state in ['check_out', 'cancel']"/>
                            <field name="expected_date" string="Expected Check-Out" readonly="1"
                                   invisible="state in ['check_out', 'cancel']"/>

                        </group>
                        <group>
                            <field name="bed_type" string="Bed Type"/>
                            <field name="check_in" string="Check-In Time"/>
                            <field name="check_out" string="Check-Out Time"/>
                            <field name="facilities" string="Facilities" widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="room_id" string="Room"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('id', 'in', available_room_ids)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Other Guests" invisible="number_of_guests == 1">
                            <field name="other_guests" colspan="2" nolabel="1">
                                <list editable="bottom">
                                    <field name="guest_ids"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payment">
                            <field name="payment_line_ids">
                                <list>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_of_measure"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total amount payable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_accommodation_view_search" model="ir.ui.view">
        <field name="name">hotel.accommodation.view.search</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_id" string="Room Number"/>
                <field name="guest" string="Guest"/>
                <field name="name" string="Sequence"/>

                <filter name="open_records" string="Open" domain="[('state','!=','cancel')]"/>
                <filter name="state_check_in" string="Check-Ins" domain="[('state', '=', 'check_in')]"/>
                <filter name="check_out" string="Current Day Check-Outs"
                        domain="[('check_out','=',(context_today()))]"/>
                <filter name="expected_current_day" string="Expected checkouts today"
                        domain="[('expected_date','=',(context_today()))]"/>
                <filter name="expected_next_day" string="Next-day expected checkouts"
                        domain="[('expected_date','=',(context_today()+relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>

                <group name="groupby">
                    <filter name="group_by_room" string="Room"
                            context="{'group_by': 'room_id'}"/>
                    <filter name="group_by_type" string="Type"
                            context="{'group_by': 'bed_type'}"/>
                    <filter name="group_by_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_accommodation_view_list" model="ir.ui.view">
        <field name="name">hotel.accommodation.view.list</field>
        <field name="model">hotel.accommodation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Number" readonly="1" decoration-bf="1"/>
                <field name="bed_type" string="Bed Type"/>
                <field name="guest" string="Guest"/>
                <field name="number_of_guests" string="Number of Guests"/>
                <field name="expected_days" string="Expected days"/>
                <field name="expected_date" string="Expected Check-Out"
                       decoration-warning="color_code == 'yellow'"
                       decoration-danger="color_code == 'red'"
                />
                <field name="check_in" string="Check-In Time"/>
                <field name="check_out" string="Check-Out Time"/>
                <field name="room_id" string="Room"/>
            </list>
        </field>
    </record>


    <record id="order_food_view_form" model="ir.ui.view">
        <field name="name">order.food.view.form.inherit.hr</field>
        <field name="model">hotel.accommodation</field>
        <field name="inherit_id" ref="hotel_management.hotel_accommodation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-taxi"
                        name="action_open_orders"
                        invisible="state == 'draft'">
                    <field string="Order Food" name="order_count" widget="statinfo"/>
                </button>
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-bars"
                        name="action_open_invoices"
                        invisible="not invoice_id">
                    <field string="Invoice" name="invoice_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

