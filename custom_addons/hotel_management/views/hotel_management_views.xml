<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_management_page" model="website.page">
        <field name="name">Hotel Management Page</field>
        <field name="type">qweb</field>
        <field name="url">/hotel_management</field>
        <field name="is_published">True</field>
        <field name="key">website_hotel_management.hotel_management_page</field>
        <field name="arch" type="xml">
            <t name="Hotel Management Page" t-name="website_hotel_management.hotel_management_page">
                <t t-call="website.layout">
                    <div class="container text-center">
                        <h1 style="color: #714B67;">Welcome to Hotel Management Page</h1>
                        <p>:)</p>
                    </div>
                    <div class="oe_structure">
                        <h1>Hi </h1>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="menu_hotel_mangement" model="website.menu">
        <field name="name">Hotel Management</field>
        <field name="url">/hotel_management</field>
        <field name="page_id" ref="website_hotel_management.hotel_management_page"/>
        <field name="parent_id" ref="website.main_menu"/>
    </record>
</odoo>