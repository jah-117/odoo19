<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="s_hotel_booking_form" name="Hotel Booking">
      <t t-set="head">
        <t t-call-asssets="web.assets_frontend" t-js="false"/>
      </t>
        <section class="s_hotel_booking" data-vcss="s_hotel_booking">
            <div class="container-fluid">
                <form id="booking_form" action="/booking/submit" method="POST" enctype="multipart/form-data" class="o_mark_required"
                      data-success-mode="redirect" data-success-page="/contactus-thank-you">
                    <div class="s_website_form_rows row s_col_no_bgcolor">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row">
                            <div class="col">
                                <div class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="guest">
                                        Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm">
                                        <input id="guest" t-att-value="request.env.user.name" type="text" class="form-control" name="guest" required="1"/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <!-- Phone Field -->
                            <div class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="bed_type">
                                        Bed Type
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm">
                                        <select id="bed_type" type="text" class="form-control" name="bed_type" required="1">
                                            <option value="single">Single</option>
                                            <option value="double">Double</option>
                                            <option value="dormitory">Dormitory</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <div class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="room_id">
                                        Available Rooms
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm">
                                        <select id="room_id" type="text" class="form-control" name="room_id" required="1">

                                        </select>
                                    </div>
                                </div>
                            </div>
                            </div>
                            <!-- Name Field -->
                            <div class="col">
                            <div class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;"
                                           for="check_in">
                                        Expected time of check in
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm">
                                        <input id="check_in" type="datetime-local" class="form-control"
                                               name="check_in" required="1"
                                        />
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <div class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="expected_days">
                                        Expected days
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm">
                                        <input id="expected_days" type="number" class="form-control"
                                               name="expected_days" required="1"/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                                </div>
                            <div id="guest_lines_form" class="form-group col-12">
                                <div class="row">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;"
                                           for="other_guest_names">
                                        Other Guest(s)
                                    </label>
                                    <div class="col-sm">
                                        <table class="table table-bordered">
                                            <thead>
                                                <th class="w-50 p-3">Name</th>
                                                <th class="w-50 p-3">Age</th>
                                                <th class="w-50 p-3" >Gender</th>
                                            </thead>
                                            <tbody>

                                            </tbody>

                                        </table>
                                        <button type="button" id="add_guest_line" class="btn btn-secondary">Add another guest
                                    </button>
                                    </div>
                                </div>
                            </div>
                            <!--Submit Button-->
                            <div class="col rt">
                                <div class="form-group col-12">

                                </div>
                            </div>
                            <div class="col rt">
                            <div class="form-group col-12">
                                <div style="width: 200px;"></div>
                                <button type="submit" class="btn btn-primary">Confirm Booking</button>
                            </div>
                                </div>
                        </div>
                    </div>
                </form>
            </div>
        </section>

    </template>
</odoo>