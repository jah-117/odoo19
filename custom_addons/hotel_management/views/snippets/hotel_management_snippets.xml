<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="basic_snippet_banner" inherit_id="website.snippets"
              name="Snippet banner">
        <xpath  expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="s_hotel_management" t-snippet="website.s_snippet_group"  string="Hotel Management snippets"/>
        </xpath>
         <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="hotel_management.basic_snippet_template" string="Hotel Banner" group="s_hotel_management"/>
             <t t-snippet="hotel_management.s_hotel_booking_form" string="Booking Form" group="s_hotel_management"/>
             <t t-snippet="hotel_management.s_room_details" string="Room Details" group="s_hotel_management"/>
             <t t-snippet="hotel_management.s_hotel_images" string="Hotel Images" group="s_hotel_management"/>
        </xpath>
    </template>
</odoo>