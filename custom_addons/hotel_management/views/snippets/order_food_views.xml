<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_order_food_page" model="website.page">
        <field name="name">Order food page</field>
        <field name="type">qweb</field>
        <field name="url">/hotel_management/order_food</field>
        <field name="is_published">True</field>
        <field name="key">hotel_management.hotel_order_food_page</field>
        <field name="arch" type="xml">
            <t name="Order food Page" t-name="hotel_management.hotel_order_food_page">
                <t t-call="website.layout">
                    <t t-set="head">
                        <t t-call-asssets="web.assets_frontend" t-js="false"/>
                    </t>
                    <div class="order-food" data-vcss="order_food">
                            <div class="split left">
                                <div id="food_items" class="row row-cols-1 row-cols-md-5 g-3">
                                    <div class="centered">
                                        Loading available food items
                                    </div>
                                </div>
                            </div>
                            <div class="split right">
                                <div id="cart" class="row row-cols-1 row-cols-md-2 g-3">
                                    cart
                                </div>
                                <div class="row">
                                    <div id="total" class="col total">
                                        total
                                        <button class="add_add">button</button>
                                    </div>
                                    <div id="confirm" class="col confirm">
                                        <button class="confirm btn btn-primary">Confirm</button>
                                    </div>
                                </div>
                            </div>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <record id="menu_order_food" model="website.menu">
        <field name="name">Order food</field>
        <field name="url">/hotel_management/order_food</field>
        <field name="page_id" ref="hotel_management.hotel_order_food_page"/>
        <field name="parent_id" ref="website.main_menu"/>
    </record>
</odoo>