<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hotel_management_page" model="website.page">
        <field name="name">Hotel Management Page</field>
        <field name="type">qweb</field>
        <field name="url">/hotel_management</field>
        <field name="is_published">True</field>
        <field name="key">hotel_management.hotel_management_page</field>
        <field name="arch" type="xml">
            <t name="Hotel Management Page" t-name="hotel_management.hotel_management_page">
                <t t-call="website.layout">
                    <div class="oe_structure">

                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="thankyou_for_booking" model="website.page">
        <field name="name">Hotel Management Page</field>
        <field name="type">qweb</field>
        <field name="url">/thankyou_for_booking</field>
        <field name="is_published">True</field>
        <field name="key">hotel_management.thankyou_for_booking</field>
        <field name="arch" type="xml">
            <t name="Hotel Management Page" t-name="hotel_management.thankyou_for_booking">
                <t t-call="website.layout">
                    <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="col-lg-6 offset-lg-1 text-center">
                                    <div class="d-inline-block mx-auto p-4">
                                        <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="presentation"/>
                                        <h1 class="fw-bolder">Thank You!</h1>
                                        <p class="lead mb-0">Booking has been confirmed.</p>
                                        <p class="lead">The room has been reserved for you.</p>
                                        <a href="/">Go to Homepage</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="no_room_available" model="website.page">
        <field name="name">Hotel Management Page</field>
        <field name="type">qweb</field>
        <field name="url">/no_room_available</field>
        <field name="is_published">True</field>
        <field name="key">hotel_management.no_room_available</field>
        <field name="arch" type="xml">
            <t name="Hotel Management Page" t-name="hotel_management.no_room_available">
                <t t-call="website.layout">
                    <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="col-lg-6 offset-lg-1 text-center">
                                    <div class="d-inline-block mx-auto p-4">
                                        <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-danger" role="presentation"/>
                                        <h1 class="fw-bolder">Oops!</h1>
                                        <p class="lead mb-0">Booking cannot be confirmed.</p>
                                        <p class="lead">No rooms are available at the moment.</p>
                                        <a href="/">Go to Homepage</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </t>
            </t>
        </field>
    </record>
    <record id="main_menu_hotel_mangement" model="website.menu">
        <field name="name">Hotel Management</field>
        <field name="url">/</field>
        <field name="parent_id" ref="website.main_menu"/>
    </record>
    <record id="menu_hotel_mangement" model="website.menu">
        <field name="name">Hotel Management</field>
        <field name="url">/hotel_management</field>
        <field name="page_id" ref="hotel_management.hotel_management_page"/>
        <field name="parent_id" ref="hotel_management.main_menu_hotel_mangement"/>
    </record>
</odoo>