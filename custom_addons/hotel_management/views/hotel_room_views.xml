<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_rooms" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Rooms
            </p>
        </field>
    </record>
    <record id="room_view_search" model="ir.ui.view">
        <field name="name">hotel.room.view.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="room_no_id" string="Room No"/>
                <filter name="available_room" string="Available" domain="[('state','=','available')]"/>
                <group name="groupby">
                    <filter name="group_by_bed_type" string="By Bed type"
                            context="{'group_by':'bed'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="room_view_form" model="ir.ui.view">
        <field name="name">hotel.room.view.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'convert_to_webp': True, 'preview_image': 'image', 'zoom': True}"/>
                    <group>
                        <group>
                            <field name="room_no_id"/>
                            <field name="bed"/>
                            <field name="available_beds" required="bed == 'dormitory'" invisible="bed != 'dormitory'"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1" />
                            <field name="rent"/>
                            <field name="facility_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="room_view_list" model="ir.ui.view">
        <field name="name">hotel.room.view.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="room_no_id"/>
                <field name="bed"/>
                <field name="available_beds" required="bed == 'dormitory'" invisible="bed != 'dormitory'"/>
                <field name="state"/>
                <field name="currency_id" invisible="1" />
                <field name="rent"/>
            </list>
        </field>
    </record>

</odoo>