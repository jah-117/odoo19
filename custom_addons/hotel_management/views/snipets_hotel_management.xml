<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="basic_snippet_template" name="Basic Snippet">
        <section class="s_basic_snippet">
                <div class="container py-4">
                    <div class="row">
                        <div class="col-12 text-center"
                        t-attf-style="background-image:url('/hotel_mangement/')">
                            <h2>Basic Snippet</h2>
                            <p>
                                This is a simple static snippet created in Odoo 19.
                                You can use it to display fixed content on your website.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
    </template>

    <template id="basic_snippet_banner" inherit_id="website.snippets"
              name="Snippet banner">
        <xpath  expr="//snippets[@id='snippet_groups']/*[1]" position="before">
            <t snippet-group="basic_snippet" t-snippet="website.s_snippet_group"  string="Basic Snippet Registration"/>
        </xpath>
         <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="website_hotel_management.basic_snippet_template" string="Custom snippet" group="basic_snippet"/>
        </xpath>
    </template>
</odoo>