<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_fooditems" model="ir.actions.act_window">
        <field name="name">Food Items</field>
        <field name="res_model">food.items</field>
        <field name="res_model">food.items</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Facility
            </p>
        </field>
    </record>

    <record id="fooditems_view_list" model="ir.ui.view">
        <field name="name">food.items.view.list</field>
        <field name="model">food.items</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="item"/>
                <field name="quantity"/>
                <field name="price"/>
            </list>
        </field>
    </record>
</odoo>