<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="checkout_remainder_mail_template" model="mail.template">
            <field name="name">checkout.remainder.mail</field>
            <field name="model_id" ref="hotel_management.model_hotel_accommodation"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="subject">Remainder for check-out</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <div style="justify-content: center;background-color: #714B67; padding:0.6rem;padding-left: 35px;text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;width:40%">
                        <h2>
                            Hi,
                            <t t-out="object.partner_id.name"/>
                        </h2>
                        <div>
                            <h3>
                                This mail is to remaind you that your expected
                                check-out is today.
                            </h3>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    {{object.expected}}
                    Regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                </div>
            </field>
        </record>
    </data>
</odoo>