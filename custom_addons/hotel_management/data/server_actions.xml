<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_create_lunch_product" model="ir.actions.server">
            <field name="name">create.lunch.product</field>
            <field name="model_id" ref="hotel_management.model_food_items"/>
            <field name="state">code</field>
            <field name="path">hotel_management</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="code">action = model._create_lunch_product()</field>
        </record>

        <record id="automated_action_create_lunch_product_on_food_item" model="base.automation">
            <field name="name">lunch.product.on.food.item.creation</field>
            <field name="model_id" ref="hotel_management.model_food_items"/>
            <field name="trigger">on_create</field>
            <field name="action_server_ids" eval="[(4, ref('action_create_lunch_product'))]"/>
        </record>
    </data>
</odoo>