<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="cron_check_out_remainder" model="ir.cron">
            <field name="name">Accommodation: check out remainder</field>
            <field name="model_id" ref="model_hotel_accommodation"/>
            <field name="state">code</field>
            <field name="code">model._send_todays_checkout_mails()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"/>
            <field name="priority">2</field>
            <field name="active">True</field>
        </record>

        <record id="cron_archive_canceled" model="ir.cron">
            <field name="name">Accommodation: archive canceled accommodations</field>
            <field name="model_id" ref="model_hotel_accommodation"/>
            <field name="state">code</field>
            <field name="code">model._archive_canceled_records()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:00:00')"/>
            <field name="priority">3</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>