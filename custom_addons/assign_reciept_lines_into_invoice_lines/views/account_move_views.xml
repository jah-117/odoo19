<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_and_stock_move" model="ir.ui.view">
        <field name="name">account.move.stock.move</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button name="action_assign" string="Assign" type="object" invisible="move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//div[hasclass('o_col')]" position="after">
                <field name="receipt" invisible="move_type != 'out_invoice'" domain="[('picking_type_code','=','incoming')]"/>
            </xpath>
        </field>
    </record>
</odoo>